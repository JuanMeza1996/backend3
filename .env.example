# Puerto de la API
PORT=8080

# Entorno de ejecución
NODE_ENV=development

# MongoDB principal
MONGO_URI=mongodb://localhost:27017/shipnow

# MongoDB exclusivo para tests
MONGO_URI_TEST=mongodb://localhost:27017/shipnow_test

# Nivel de logging
LOG_LEVEL=info

# Configuración de uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/documents